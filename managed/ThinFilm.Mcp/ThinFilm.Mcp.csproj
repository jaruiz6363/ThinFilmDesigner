<Project Sdk="Microsoft.NET.Sdk">

  <!-- X1.9, binding to X1.7. Stateful, which is what the session-based API was built for: a
       conversation opens a design once and works on it across a dozen turns. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>thinfilm-mcp</AssemblyName>
    <RootNamespace>ThinFilm.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThinFilm.Api\ThinFilm.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <NativeLibrary Include="..\..\build\**\thinfilm_native.dll" />
    <NativeLibrary Include="..\..\build\**\libthinfilm_native.so" />
    <NativeLibrary Include="..\..\build\**\libthinfilm_native.dylib" />
    <None Include="@(NativeLibrary)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
