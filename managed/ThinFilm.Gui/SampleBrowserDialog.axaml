<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ThinFilm.Gui.SampleBrowserDialog"
        Title="Open sample design" Width="980" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <!-- MODAL. The samples shipped beside the program, by folder, with what each one says it is.
       Open closes with the design's path; the window opens it as a copy, so Save asks where. -->
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="#505050"/>
      <TextBox x:Name="FilterBox" Watermark="words in a name, category, author, year or the notes: polarizer 1969"/>
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                Margin="0,8,0,0">
      <Button x:Name="OkButton" Content="Open" IsDefault="True" MinWidth="80" IsEnabled="False"/>
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="80"/>
    </StackPanel>

    <Grid ColumnDefinitions="380,6,*">
      <Border BorderBrush="#D0D0D0" BorderThickness="1">
        <TreeView x:Name="SampleTreeView"/>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
      <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
            <TextBlock x:Name="GroupText" Foreground="#505050" TextWrapping="Wrap"/>
            <TextBlock x:Name="SourceLabel" Text="Source" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <SelectableTextBlock x:Name="SourceText" TextWrapping="Wrap"/>
            <TextBlock x:Name="NotesLabel" Text="Notes" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <SelectableTextBlock x:Name="NotesText" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
