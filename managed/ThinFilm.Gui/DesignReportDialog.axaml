<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ThinFilm.Gui.DesignReportDialog"
        Title="Export design report" Width="520" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <!-- MODAL. Export… asks where to save, and the file is written only then. -->
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="n, k tables" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="From" VerticalAlignment="Center"/>
      <TextBox x:Name="FromBox" Width="80"/>
      <TextBlock Text="to" VerticalAlignment="Center"/>
      <TextBox x:Name="ToBox" Width="80"/>
      <TextBlock Text="every" VerticalAlignment="Center"/>
      <TextBox x:Name="StepBox" Width="70"/>
      <TextBlock x:Name="UnitText" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock FontSize="11" Foreground="#505050" TextWrapping="Wrap"
               Text="The range starts as the Spectrum tab's - the design's saved plot when it has one."/>

    <Border Height="1" Background="#E0E0E0"/>
    <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" FontSize="11" Foreground="#505050"/>
    <TextBlock x:Name="ProblemText" Foreground="#B00020" TextWrapping="Wrap" IsVisible="False"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="Export…" IsDefault="True" MinWidth="80"/>
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</Window>
